DATABASE_URL="file:./dev.db"
HOSTNAME="0.0.0.0"
# Railway/Docker: bind to all interfaces (do not use container HOSTNAME).
BIND_HOST="0.0.0.0"
PORT=3000
# Optional: comma-separated allowed browser origins, e.g. http://192.168.1.10:3000
# If empty, Socket.IO only accepts same-origin browser requests.
ALLOWED_ORIGINS=""
RECONNECT_GRACE_SECONDS=60

# Public browser key. Enable Maps JavaScript API; restrict by HTTP referrer.
# NEXT_PUBLIC_* values are included in the client build; rebuild after changing.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
# Server only. Enable Street View Static API; restrict API and egress IP where available.
GOOGLE_MAPS_SERVER_KEY=""
# Optional URL signing secret from Google Cloud; server only, never a browser key.
GOOGLE_MAPS_SIGNING_SECRET=""
# Empty = same origin (recommended for the combined server).
# Production override must be https://YOUR-DOMAIN (Socket.IO upgrades to wss automatically).
NEXT_PUBLIC_SOCKET_URL=""
# Comma-separated browser origins. Production: HTTPS only. Empty = same origin.
CLIENT_ORIGIN=""
# memory or database. Store only location identifiers + timestamps, never API keys/images.
LOCATION_HISTORY_STORAGE="memory"
LOCATION_HISTORY_LIMIT=75
GOOGLE_MAX_ATTEMPTS=8
GOOGLE_MIN_DISTANCE_KM=1
